TRS_API_BASE_URL=http://localhost:8080
TRS_BOT_SERVICE_TOKEN=timer-registration-system-local-bot-service-token-change-later
TRS_EXTERNAL_PROVIDER=CLAUDE_DESKTOP
TRS_EXTERNAL_PROVIDER_USER_ID=admin-local

# Phase 24B: AI planner settings.
# AI planner proposes an intent only; the harness still validates and executes safely.
AI_PLANNER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Set to off when you want response-only output.
HARNESS_LOG_LEVEL=info
